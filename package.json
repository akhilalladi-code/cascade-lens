{
  "name": "cascade-lens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --noEmit --pretty false -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc --noEmit --pretty false -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke && npm run test:e2e"
  },
  "dependencies": {
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.0",
    "vitest": "^5.1.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.44.1"
  },
  "description": "A local-first CSS cascade debugger for selector matching, specificity, source order and computed styles.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
